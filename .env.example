# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# --- Mesh API (required: every LLM/AI call goes through Mesh) ---
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_REASONING_MODEL=openai/gpt-4o
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- App ---
SECRET_KEY=change-me-to-something-random
DATABASE_URL=sqlite:///data/smartreco.db

# --- Vector store ---
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=smartreco_products

# --- Recommendation economics (controls how often the agent may run) ---
REC_MIN_NEW_EVENTS=5
REC_CACHE_TTL_SECONDS=1800
REC_MIN_SECONDS_BETWEEN_RUNS=120
REC_PRODUCTS_RETURNED=4
REC_RETRIEVAL_K=12
REC_MAX_REFINE_LOOPS=2

# --- Scheduler (bonus: proactive delivery) ---
ENABLE_SCHEDULER=true
DIGEST_HOUR=16
DIGEST_MINUTE=0
DIGEST_TIMEZONE=UTC

# --- Email delivery (optional; without it digests are written to data/outbox/) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartReco <noreply@smartreco.local>
SMTP_USE_TLS=true

# --- Observability (bonus: LangSmith) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smartreco
